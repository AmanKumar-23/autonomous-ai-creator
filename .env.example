# Copy to .env.local (gitignored) and fill in. Never commit real keys.
# The read path (feed + init + viewer) needs NONE of these — it only reads
# committed JSON. These are for the write path (agent/) added in later phases.

# Tier 1 LLM provider
GROQ_API_KEY=

# Tier 2 LLM provider (failover)
GEMINI_API_KEY=

# Breeth — semantic memory / dedup
BREETH_API_KEY=
