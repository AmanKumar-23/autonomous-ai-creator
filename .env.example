# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# --- Required in Vercel for the deployed init endpoint ---
# On Vercel the filesystem is read-only, so POST /api/agent/init persists state
# by committing data/state.json through the GitHub API. Without this token the
# init still returns an agentId, but the cron never sees it and never publishes.
# Fine-grained PAT, scoped to this repo only, with Contents: read and write.
GITHUB_TOKEN=
# Optional overrides — sensible defaults are built in.
GITHUB_REPO=AmanKumar-23/autonomous-ai-creator
GITHUB_BRANCH=main

# --- Write path (agent/), added in later phases ---
# The feed endpoint needs none of these; it only reads committed JSON.

# Tier 1 LLM provider
GROQ_API_KEY=

# Tier 2 LLM provider (failover)
GEMINI_API_KEY=

# Breeth — semantic memory / dedup
BREETH_API_KEY=
